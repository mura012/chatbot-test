# OpenAI API キー（CHATBOT_BACKEND=openai のとき必須）
# OPENAI_API_KEY=sk-...

# 使用するモデル（省略時: gpt-4o-mini）
# OPENAI_MODEL=gpt-4o-mini

# バックエンドの選択: openai | rule
# 省略時: APIキーがあれば openai、なければ rule
# CHATBOT_BACKEND=rule

# システムプロンプト（OpenAI モード時）
# CHATBOT_SYSTEM_PROMPT=あなたは親切で簡潔に答えるアシスタントです。

# Web サーバーのホスト・ポート
# CHATBOT_HOST=127.0.0.1
# CHATBOT_PORT=8000

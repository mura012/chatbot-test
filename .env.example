# OpenAI API キー（openai / openai_rag のとき必須）
# OPENAI_API_KEY=sk-...

# 使用するモデル（省略時: gpt-4o-mini）
# OPENAI_MODEL=gpt-4o-mini

# Embeddings モデル（RAG + embedding 検索時）
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# バックエンドの選択:
#   rule        — キーワードルール（RAG なし）
#   openai      — OpenAI API（RAG なし）
#   rule_rag    — sample/ をキーワード検索して表示（API 不要）
#   openai_rag  — sample/ を検索 + OpenAI で回答（推奨）
#   rag         — API キーの有無で openai_rag / rule_rag を自動選択
# 省略時: API キーがあれば openai_rag、なければ rule_rag
# CHATBOT_BACKEND=rag

# 知識ベースのディレクトリ（省略時: sample）
# CHATBOT_KNOWLEDGE_DIR=sample

# RAG で取得するチャンク数（省略時: 3）
# CHATBOT_RAG_TOP_K=3

# RAG の検索方式: keyword | embedding
# 省略時: API キーありなら embedding、なければ keyword
# CHATBOT_RAG_RETRIEVER=keyword

# システムプロンプト（openai モード時）
# CHATBOT_SYSTEM_PROMPT=あなたは親切で簡潔に答えるアシスタントです。

# Web サーバーのホスト・ポート
# CHATBOT_HOST=127.0.0.1
# CHATBOT_PORT=8000
